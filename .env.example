# Copy to .env (gitignored). Create the token yourself with `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=
# Do NOT set ANTHROPIC_API_KEY here: it outranks the OAuth token in -p mode.

# Where the harness reads the sink's request log (sink admin port).
# Default: the local compose sink. For the Raspberry Pi over Tailscale, point this at the Pi
# and map the attacker hostnames to the Pi's IP with SINK_IP.
SINK_URL=http://127.0.0.1:8099
